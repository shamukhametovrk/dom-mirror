# Настройки. install.sh заполняет их сам; вручную: cp .env.example .env и поправить.

# Адрес сервиса. <IP сервера>.sslip.io работает без покупки домена.
# localhost — HTTPS с локальным сертификатом; :80 — без HTTPS (запуск на своём компьютере).
DOMAIN=:80

# Пароль для входа. Пусто — сгенерируется при первом запуске.
PASSWORD=

# Порты на хосте.
HTTP_PORT=80
HTTPS_PORT=443

# Сайты — постоянные вкладки: «Имя=адрес» через запятую. Пусто — Claude, Алиса и ChatGPT.
SITES=

# Часовой пояс и языки браузера — под страну IP сервера, иначе чаще проверки «я не робот».
TZ=Europe/Moscow
ACCEPT_LANGUAGES=ru-RU,ru,en-US,en

# 1 — писать в лог типы входящих сообщений (без содержимого).
DEBUG=0

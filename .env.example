# Скопируйте в .env и поменяйте нужное: cp .env.example .env
# Docker Compose читает .env из папки проекта автоматически.

# Пароль для входа. Пусто — сгенерируется при первом запуске:
#   docker compose logs | grep "Пароль"   или   docker compose exec dom-mirror cat /data/password
PASSWORD=

# Порт на хосте и интерфейс. За обратным прокси на той же машине ставьте HTTP_BIND=127.0.0.1.
HTTP_PORT=8095
HTTP_BIND=0.0.0.0

# Страница, которая откроется при запуске.
START_URL=https://ru.wikipedia.org/

# Часовой пояс и языки браузера. Должны совпадать со страной IP-адреса сервера,
# иначе сайты видят несостыковку и чаще показывают проверки «я не робот».
TZ=Europe/Moscow
ACCEPT_LANGUAGES=ru-RU,ru,en-US,en

# 1 — сервис работает за обратным прокси (nginx, Caddy, Traefik): доверять X-Forwarded-Proto/Host.
TRUST_PROXY=0

# 0 — не показывать iframe с чужих сайтов (виджеты капчи, видео) живой картинкой.
FRAMES=1

# 1 — писать в лог типы входящих сообщений (без содержимого).
DEBUG=0
